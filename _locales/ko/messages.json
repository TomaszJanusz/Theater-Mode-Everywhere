  "vimeoIntegrationDescription": {
    "message": "동영상이나 플레이어가 제공하는 경우 사용 가능: 제목, 챕터, 미리보기 이미지. 빠른 동작: 쇼케이스의 다음 동영상."
  },
  "patreonIntegrationTitle": {
