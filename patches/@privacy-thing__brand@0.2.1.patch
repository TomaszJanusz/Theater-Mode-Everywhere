diff --git a/dist/dom.js b/dist/dom.js
new file mode 100644
index 0000000000000000000000000000000000000000..012a7d29b25978b47b0ad6b29f21d1eebd6fe03f
--- /dev/null
+++ b/dist/dom.js
@@ -0,0 +1,20 @@
+// Only for this package's generated templates: assets, enum options and resolved numbers.
+// Never use this renderer with page, network, storage or localized copy.
+export function replaceTemplate(target, markup) {
+    const owner = target.ownerDocument;
+    const parsed = new DOMParser().parseFromString(markup, "text/html");
+    const copy = (source) => {
+        if (source.nodeType === 3) return owner.createTextNode(source.textContent ?? "");
+        if (source.nodeType !== 1) return owner.createTextNode("");
+        const element = owner.createElementNS(source.namespaceURI, source.localName);
+        for (const attribute of source.attributes) {
+            // HTML parsing leaves some prefixed SVG asset attributes unnamespaced.
+            if (attribute.namespaceURI) element.setAttributeNS(attribute.namespaceURI, attribute.name, attribute.value);
+            else element.setAttribute(attribute.name, attribute.value);
+        }
+        for (const child of source.childNodes) element.appendChild(copy(child));
+        return element;
+    };
+    // The stylesheet is parsed into head; preserve its position ahead of the logo.
+    target.replaceChildren(...[...parsed.head.childNodes, ...parsed.body.childNodes].map(copy));
+}
