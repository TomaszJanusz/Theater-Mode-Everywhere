{
  "name": "theater-everywhere",
  "version": "2.0.7",
  "description": "Maximize any HTML5 video player to fill the browser viewport with a single keypress [T].",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify:bundles": "tsx scripts/verify-bundles.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:chromium": "tsx scripts/smoke.ts chromium",
    "smoke:firefox": "tsx scripts/smoke.ts firefox",
    "store:cws:screenshots": "tsx scripts/render-cws-screenshots.ts",
    "store:chrome:print": "tsx scripts/print-store-listing.ts",
    "store:amo:update": "tsx scripts/update-amo-listings.ts",
    "cpu:suite": "tsx tools/cpu-suite/suite.ts",
    "build:diagnostic": "TME_BUILD=diagnostic tsx scripts/build.ts",
    "resource:audit": "tsx tools/cpu-suite/resource-suite.ts"
  },
  "author": "Tomasz Janusz",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.12.7",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "tsx": "^4.7.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@privacy-thing/brand": "^0.2.1"
  }
}
