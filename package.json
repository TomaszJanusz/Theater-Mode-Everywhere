{
  "name": "theater-everywhere",
  "version": "2.0.5",
  "description": "Maximize any HTML5 video player to fill the browser viewport with a single keypress [T].",
  "main": "index.js",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify:bundles": "tsx scripts/verify-bundles.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:chromium": "tsx scripts/smoke.ts chromium",
    "smoke:firefox": "tsx scripts/smoke.ts firefox",
    "store:cws:screenshots": "tsx scripts/render-cws-screenshots.ts",
    "store:chrome:print": "tsx scripts/print-store-listing.ts",
    "store:amo:update": "tsx scripts/update-amo-listings.ts",
    "audio:charts": "tsx tools/audio-charts/generate.ts",
    "cpu:suite": "tsx tools/cpu-suite/suite.ts",
    "build:diagnostic": "TME_BUILD=diagnostic tsx scripts/build.ts",
    "resource:audit": "tsx tools/cpu-suite/resource-suite.ts",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --output-dir output/storybook-static",
    "storybook:shots": "pnpm storybook:build && tsx scripts/storybook-shots.ts",
    "storybook:shots:firefox": "pnpm storybook:build && tsx scripts/storybook-shots.ts firefox",
    "storybook:test": "vitest run --config vitest.config.ts",
    "lint": "eslint . --config config/eslint.config.mjs --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "check": "pnpm lint && pnpm typecheck && pnpm exec tsx --test scripts/test-determinism.test.ts scripts/test-harness.test.ts",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm verify:bundles",
    "lint:suppressions:prune": "pnpm lint --prune-suppressions"
  },
  "author": "Tomasz Janusz",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/roboto": "^5.3.0",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/html-vite": "^10.6.2",
    "@types/archiver": "^6.0.2",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "^5.0.5",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "4.6.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.2",
    "tsx": "^4.7.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@privacy-thing/brand": "^0.2.1"
  }
}
