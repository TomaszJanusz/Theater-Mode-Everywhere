{
  "schemaVersion": 1,
  "id": "disney",
  "hosts": [
    {
      "domain": "disneyplus.com",
      "includeSubdomains": true
    }
  ],
  "home": "https://www.disneyplus.com/",
  "entries": {
    "isolated": {
      "file": "isolated.ts",
      "runAt": "document_start"
    },
    "main": {
      "file": "main-entry.ts",
      "runAt": "document_start"
    }
  },
  "settings": [
    {
      "id": "autoTheater",
      "type": "boolean",
      "default": true,
      "label": "autoEnterTheaterTitle",
      "description": "autoEnterTheaterDescription"
    }
  ]
}
