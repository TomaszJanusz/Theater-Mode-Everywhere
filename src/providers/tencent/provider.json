{
  "schemaVersion": 1,
  "id": "tencent",
  "hosts": [
    {
      "domain": "v.qq.com",
      "includeSubdomains": true
    },
    {
      "domain": "wetv.vip",
      "includeSubdomains": true
    },
    {
      "domain": "vm.gtimg.cn",
      "includeSubdomains": false
    }
  ],
  "mediaFetch": [
    {
      "kind": "caption-track",
      "host": "cffaws.wetvinfo.com",
      "pathname": "^/.*\\.(?:[vV][tT][tT]|[sS][rR][tT])$"
    },
    {
      "kind": "caption-track",
      "host": "subtitle.wetvinfo.com",
      "pathname": "^/.*\\.(?:[vV][tT][tT]|[sS][rR][tT])$"
    },
    {
      "kind": "caption-track",
      "host": "subtitle.tc.qq.com",
      "pathname": "^/.*\\.(?:[vV][tT][tT]|[sS][rR][tT])$"
    },
    {
      "kind": "caption-track",
      "host": "subtitlebk.apdcdn.tc.qq.com",
      "pathname": "^/.*\\.(?:[vV][tT][tT]|[sS][rR][tT])$"
    }
  ],
  "entries": {
    "isolated": {
      "file": "isolated.ts",
      "runAt": "document_start"
    },
    "main": {
      "file": "main-entry.ts",
      "runAt": "document_start"
    }
  }
}
